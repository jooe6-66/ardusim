# Frontend (Cloudflare Pages / Local)
# Set to your deployed Hugging Face Space URL or local/tunnel compiler URL (no trailing slash)
VITE_COMPILER_URL=http://127.0.0.1:7860
# Contoh produksi (Hugging Face Spaces Docker):
# VITE_COMPILER_URL=https://<username>-<space-name>.hf.space

# Compiler Backend (Hugging Face Spaces / Local Docker)
PORT=7860
HOST=0.0.0.0
# Comma-separated allowed browser origins (supports wildcards like https://*.ardusim.pages.dev); empty = allow all origins (local dev)
CORS_ORIGIN=
RATE_LIMIT_PER_MIN=120
MAX_CONCURRENT_COMPILES=2
MAX_QUEUE_SIZE=24
COMPILE_TIMEOUT_MS=30000
