# Frontend (Cloudflare Pages / Local)
# Set to your local or tunnel compiler URL (no trailing slash), e.g. http://127.0.0.1:7860 or https://compiler.domainmu.com
VITE_COMPILER_URL=http://127.0.0.1:7860

# Compiler Backend (Local / Docker)
PORT=7860
HOST=0.0.0.0
RATE_LIMIT_PER_MIN=120
MAX_CONCURRENT_COMPILES=2
MAX_QUEUE_SIZE=24
