# Frontend (Cloudflare Pages / Local)
# Set to your deployed compiler backend URL (Choreo by WSO2, Koyeb, SnapDeploy, or Tailscale Funnel; no trailing slash)
VITE_COMPILER_URL=http://127.0.0.1:8080
# Contoh produksi (Choreo / Cloud Docker / Tailscale Funnel):
# VITE_COMPILER_URL=https://ardusim-compiler.choreoapis.dev

# Compiler Backend (Docker / Local)
PORT=8080
HOST=0.0.0.0
# Comma-separated allowed browser origins (supports wildcards like https://*.ardusim.pages.dev); empty = allow all origins (local dev)
CORS_ORIGIN=
RATE_LIMIT_PER_MIN=120
# Rekomendasi container 512 MB RAM: MAX_CONCURRENT_COMPILES=1 dan COMPILE_TIMEOUT_MS=60000
MAX_CONCURRENT_COMPILES=2
MAX_QUEUE_SIZE=24
COMPILE_TIMEOUT_MS=30000
